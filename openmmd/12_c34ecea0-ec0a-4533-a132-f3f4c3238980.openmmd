  "mermaidCode": "flowchart LR\n  subgraph lane_0[\"用户\"]\n    t_0([\"录入托运信息\"])\n    t_1{\"是否确认运输\"}\n    t_2[\"不处理\"]\n    t_3{\"用户是否支付成功\"}\n    t_4[\"不处理\"]\n    t_5[\"等待支付\"]\n    t_6{\"用户是否支付\"}\n  end\n  subgraph lane_1[\"支付宝\"]\n    t_7[\"拉起收银台\"]\n    t_8[\"展示待⽀付账单\"]\n    t_9[\"接收通知\"]\n    t_10[\"接收通知\"]\n    t_11[\"展示支付成功\"]\n    t_12[\"提交订单信息\"]\n    t_13[\"展示价格信息\"]\n    t_14[\"记录托运信息\"]\n    t_15[\"展示支付成功\"]\n  end\n  subgraph lane_2[\"交付系统\"]\n    t_16[/\"使用订单的预付款金额调用支付宝js API创建交易单，生成交易单号<br/>订单状态=待支付\"\\]\n    t_17[/\"客服需要查询支付宝订单，与客户沟通确认运车细节后，才能进入运力竞价\"\\]\n    %% [tag:other] 其他 | 这里需要给客服培训，使用特定流程处理支付宝渠道的订单\n    t_18[/\"在取价规则和加价规则中为支付宝配置渠道值和规则\"\\]\n    %% [tag:existing] 已有 | 需要配置支付宝聚合搜索渠道，配置相关取价规则和加价规则，应该不涉及到代码修改，只需要配置即可\n    t_19[/\"记录查价记录\"\\]\n    t_20[/\"available：true，price_type：MEMBER，transport_type：LARGE_TRUCK，price_info:{}\"\\]\n    t_21{\"是否支付成功\"}\n    t_22{\"是否支付成功\"}\n    t_23{\"金额是否有变化\"}\n    t_24[\"【销售】补充车架号、车辆品牌信息，修改订单金额（若金额不正确）\"]\n    t_25{\"汽车还是摩托车\"}\n    t_26[\"查询支付状态\"]\n    %% [tag:new] 新增 | 新增的支付状态查询逻辑\n    t_27[\"订单状态=待竞价\"]\n    t_28[\"【销售】查看支付宝渠道订单\"]\n    t_29[\"【司机、售后】上传交车单，交车\"]\n    t_30[\"调用⽀付单状态同步接口\"]\n    %% [tag:new] 新增 | 新增接口推送逻辑\n    t_31[\"查询订单支付状态\"]\n    %% [tag:new] 新增 | 新增逻辑\n    t_32[\"【运力】确认竞价\"]\n    t_33[\"【销售】人工通知运力可以竞价\"]\n    t_34{\"是否有线路（大板、小板）价格\"}\n    t_35[\"【售后】派单\"]\n    t_36[\"【司机、售后】确认提车\"]\n    t_37[\"【司机、售后】到达交车地\"]\n    t_38[\"【司机、售后】发运\"]\n    t_39[\"下单\"]\n    %% [tag:new] 新增 | 与原有的下单接口可能不同，需要新增\n    t_40[\"创建支付宝支付单号\"]\n    %% [tag:new] 新增 | 支付宝订单需要自动调用支付宝接口，生成交易单号\n    t_41[\"关联查价单号，更新订单报价\"]\n    %% [tag:new] 新增 | 需要关联订单号\n    t_42[\"自动确认报价\"]\n    %% [tag:new] 新增 | 支付宝渠道过来的订单需要自动确认报价\n    t_43[\"查询大板线路库\"]\n    %% [tag:existing] 已有 | 在查价的时候，需要增加会员检查和自动注册逻辑\n    t_44[\"推送价格\"]\n    %% [tag:new] 新增 | 新增的推送价格接口\n    t_45[\"干线+保障服务费\"]\n    t_46[\"调用汽车托运订单状态同步同步订单状态=服务完成（CS_ARRIVED）\"]\n    %% [tag:new] 新增 | 新增接口推送逻辑\n    t_47[\"兜底计算规则，返回价格信息\"]\n    %% [tag:pending] 待确认 | 是否需要兜底计算规则，还是直接返回不能承运\n    t_48[\"调用汽车托运订单状态同步同步订单状态=运送中（CS_DELIVERING）\"]\n    %% [tag:new] 新增 | 新增接口推送逻辑\n    t_49[\"调用汽车托运订单状态同步接口同步订单状态=待接单<br/>（CS_TO_PICK_UP）\"]\n    %% [tag:new] 新增 | 新增逻辑\n    t_50[\"调用汽车托运订单状态同步同步订单状态=已接单（CS_TAKE_ORDER）\"]\n    %% [tag:new] 新增 | 新增接口推送逻辑\n    t_51[\"调用汽车托运订单状态同步同步订单状态=已取车（CS_PICKED_UP）\"]\n    %% [tag:new] 新增 | 新增接口推送逻辑\n    t_52[\"返回不可承运available=false\"]\n    t_53[\"使用支付单状态同步接口更新订单金额和支付状态\"]\n    %% [tag:new] 新增 | 新增逻辑\n    t_54[/\"缺失信息使用默认值补充，比如车型车系等，后续需要人工确认并修改\"\\]\n    t_55{\"查询次数是否超过3次\"}\n    t_56[/\"订单号关联查价单号，查价单号在下单时支付宝会传过来\"\\]\n    t_57[\"返回订单信息后，比如延迟2秒；调用汽车托运订单状态同步同步订单状态=待支付（CS_TO_PAY）\"]\n    %% [tag:new] 新增 | 新增逻辑\n    t_58[\"调用汽车托运订单状态同步同步订单状态=订单完成（CS_SUCCESS）\"]\n    %% [tag:new] 新增 | 新增接口状态同步逻辑\n    t_59[\"调用支付状态同步接口，更新状态为：待支付\"]\n    t_60{\"creator_phone是否已注册\"}\n    t_61[\"使用creator_phone注册会员\"]\n    %% [tag:new] 新增 | 在查价的时候就需要注册会员\n    t_62[/\"此处跳过了订单状态=已送达（CS_ARRIVED），因为需要推送账单给客户\"\\]\n    t_63[\"调用支付状态同步接口，\"]\n    t_64[/\"同步：待⽀付 (TO_PAY)，明细 (order_fee, base_delivery_fee 等)\"\\]\n    t_65[/\"此时无法交车\"\\]\n    t_66[\"等待10秒继续查询\"]\n    t_67{\"查询是否超过3次\"}\n    t_68[\"调用支付状态同步接口，更新状态为：待支付\"]\n    t_69[\"不处理，无需自动注册\"]\n    t_70[/\"当前支付宝支付状态缺少待支付定金还是待支付尾款，无法区分用户应当支付哪一笔\"\\]\n    t_71[\"等待10秒后再次查询\"]\n    t_72[\"调用支付状态同步接口，更新状态为：支付完成\"]\n    t_73[\"用户在其他渠道支付完成\"]\n    t_74[\"调用支付状态同步接口，更新状态为：支付完成\"]\n    t_75[\"用户在其他渠道支付完成\"]\n    t_76[/\"不允许使用微信在线支付\"\\]\n    t_77[/\"不允许使用微信在线支付\"\\]\n  end\n  t_0 --> t_14\n  t_14 --> t_25\n  t_25 -->|\"摩托车\"| t_52\n  t_25 -->|\"汽车\"| t_43\n  t_43 --> t_34\n  t_34 -->|\"是\"| t_45\n  t_43 --> t_60\n  t_60 -->|\"否\"| t_61\n  t_18 -.-> t_43\n  t_34 -->|\"否\"| t_47\n  t_47 --> t_45\n  t_13 --> t_1\n  t_1 -->|\"否\"| t_4\n  t_1 -->|\"是\"| t_12\n  t_12 -->|\"调用下单接口\"| t_39\n  t_39 --> t_41\n  t_56 -.-> t_41\n  t_41 --> t_42\n  t_42 --> t_40\n  t_40 -->|\"返回订单信息和支付信息\"| t_7\n  t_6 -->|\"否\"| t_2\n  t_7 --> t_6\n  t_6 --> t_11\n  t_11 -->|\"通知支付成功\"| t_31\n  t_31 --> t_21\n  t_21 -->|\"否\"| t_67\n  t_67 -->|\"否\"| t_71\n  t_71 --> t_31\n  t_67 -->|\"是\"| t_68\n  t_70 -.-> t_68\n  t_21 -->|\"是\"| t_27\n  t_17 -.-> t_27\n  t_27 --> t_28\n  t_28 --> t_24\n  t_24 --> t_23\n  t_23 -->|\"是\"| t_53\n  t_23 -->|\"否\"| t_33\n  t_53 --> t_33\n  t_33 --> t_32\n  t_32 --> t_35\n  t_32 --> t_50\n  t_27 --> t_49\n  t_16 -.-> t_40\n  t_35 --> t_36\n  t_36 --> t_51\n  t_36 --> t_38\n  t_38 --> t_48\n  t_38 --> t_37\n  t_37 --> t_46\n  t_62 -.-> t_46\n  t_29 --> t_58\n  t_8 --> t_3\n  t_3 -->|\"否\"| t_5\n  t_3 --> t_15\n  t_15 -->|\"推送支付状态\"| t_26\n  t_22 -->|\"否\"| t_55\n  t_26 --> t_22\n  t_55 -->|\"否\"| t_66\n  t_66 --> t_26\n  t_22 -->|\"是\"| t_29\n  t_55 -->|\"是\"| t_59\n  t_65 -.-> t_59\n  t_37 --> t_30\n  t_30 --> t_8\n  t_60 -->|\"是\"| t_69\n  t_45 --> t_44\n  t_44 --> t_13\n  t_20 -.-> t_44\n  t_30 --> t_64\n  t_54 -.-> t_39\n  t_19 -.-> t_43\n  t_29 -->|\"返回result=true\"| t_9\n  t_27 -->|\"返回result=true\"| t_10\n  t_40 -.-> t_75\n  t_75 -->|\"alipay_trade_no为空\"| t_74\n  t_73 -->|\"alipay_trade_no为空\"| t_72\n  t_37 -.-> t_73\n  t_76 -.-> t_73\n  t_77 -.-> t_75\n"
