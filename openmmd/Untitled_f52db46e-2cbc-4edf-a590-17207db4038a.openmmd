  "notes": [
    {
      "id": "cc6bcbde-4100-4c28-b127-ad141e7ea531",
      "text": "询价",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c",
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": -1
    },
    {
      "id": "f802b915-82b3-42d9-82a2-fc43fe5dca52",
      "text": "[{\n\t\"price_id\":\"1111111\",\n\t\"mileage_fee\":100000,//1000元\n\t\"order_fee\":100000,//1000元\n\t\"before_discount_fee\":100000,//1000元，无优惠\n\t\"deposit_fee\":30000//定金300元\n\t\"transport_type\":\"LARGE_TRUCK\"//大板运输\n\t....\n}]",
      "position": "over",
      "lifelineIds": [
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": 1,
      "textAlign": "left",
      "width": 351
    },
    {
      "id": "4a5d642b-195e-45af-8a32-19595c66330c",
      "text": "下单",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c",
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": 1
    },
    {
      "id": "35931dda-9298-4d18-a726-116db4b95d1b",
      "text": "{\n\t\"price_id\":\"1111111\"\n}",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c"
      ],
      "afterOrder": 2
    },
    {
      "id": "99956db1-465f-43e4-a93b-ea622aed0a2b",
      "text": "用户刚下单，需要用户支付定金",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c",
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": 3
    },
    {
      "id": "e8976ac9-0b8c-4c55-9567-52877361f109",
      "text": "{\n\torder_status:\"TO_PAY\",//待支付\n\tmileage_fee:30000,//定金300元\n\torder_fee:30000,//定金300元\n\tadditional_fee:0,//没有附加费用\n\talipay_trade_no:\"1234\"//支付宝交易号\n}",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c"
      ],
      "afterOrder": 4
    },
    {
      "id": "5c25829c-9c2b-4ed4-b1fa-d405f8e9a2c4",
      "text": "用户支付了定金，后期线下沟通，增加了提送车费用",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c",
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": 5
    },
    {
      "id": "ecf214cf-9326-44ff-8b47-acd6745461d0",
      "text": "{\n\torder_status:\"\",\n\tmileage_fee:\"\",\n\torder_fee\"\",\n\tadditional_fee:\"20000\",//增加了200元提送车\n\talipay_trade_no:\"1234\"//支付宝交易号\n}",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c"
      ],
      "afterOrder": 6
    },
    {
      "id": "8c967dc8-7490-4f5d-acc6-e0ea12a63995",
      "text": "订单状态变为CS_SERVICE_COMPLETED，给用户推送尾款账单",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c",
        "c689e429-d4e0-4eac-a690-f7a1c163b562"
      ],
      "afterOrder": 7
    },
    {
      "id": "9f8efb54-4c20-4233-8465-4a266fa12401",
      "text": "{\n\torder_status:\"TO_PAY\",//待支付\n\tmileage_fee:90000,//增加了200元后的尾款\n\torder_fee:90000,//增加了200元后的尾款\n\tadditional_fee:0,\n\talipay_trade_no:\"2345\"//支付宝交易号\n}",
      "position": "over",
      "lifelineIds": [
        "02c07087-478a-475f-80b5-eaed4fd4cb9c"
      ],
      "afterOrder": 8
    }
  ],
