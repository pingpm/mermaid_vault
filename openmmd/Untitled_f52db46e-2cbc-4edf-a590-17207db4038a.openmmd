  "notes": [
    {
      "id": "aa5d157e-0620-4def-8168-2d59208b5e7a",
      "text": "询价",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868",
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": -1
    },
    {
      "id": "8036dd0b-dbe5-4ff6-96c9-0a5fd2440ad0",
      "text": "[{\n\t\"price_id\":\"1111111\",\n\t\"mileage_fee\":100000,//1000元\n\t\"order_fee\":100000,//1000元\n\t\"before_discount_fee\":100000,//1000元，无优惠\n\t\"deposit_fee\":30000//定金300元\n\t\"transport_type\":\"LARGE_TRUCK\"//大板运输\n\t....\n}]",
      "position": "over",
      "lifelineIds": [
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": 1,
      "width": 370.35999999999996,
      "textAlign": "left"
    },
    {
      "id": "8939b204-6066-4d4b-92d8-b6209a4cdaeb",
      "text": "下单",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868",
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": 1
    },
    {
      "id": "38a33d94-93a2-4c94-a734-1ed9986f6b2e",
      "text": "{\n\t\"price_id\":\"1111111\"\n}",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868"
      ],
      "afterOrder": 2
    },
    {
      "id": "2095a04e-c636-484e-87b7-fa7b1603a9b9",
      "text": "用户刚下单，需要用户支付定金",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868",
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": 3
    },
    {
      "id": "c95ee44d-1dce-407e-a216-466cfbb513d6",
      "text": "{\n\torder_status:\"TO_PAY\",//待支付\n\tmileage_fee:30000,//定金300元\n\torder_fee:30000,//定金300元\n\tadditional_fee:0,//没有附加费用\n\talipay_trade_no:\"1234\"//支付宝交易号\n}",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868"
      ],
      "afterOrder": 4
    },
    {
      "id": "4d62229f-96ad-4f40-92bf-79e7ebb8cc80",
      "text": "用户支付了定金，后期线下沟通，增加了提送车费用",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868",
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": 5
    },
    {
      "id": "ec292c35-e096-45c4-8c85-ef3dd84cb1ed",
      "text": "{\n\torder_status:\"\",\n\tmileage_fee:\"\",\n\torder_fee\"\",\n\tadditional_fee:\"20000\",//增加了200元提送车\n\talipay_trade_no:\"1234\"//支付宝交易号\n}",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868"
      ],
      "afterOrder": 6
    },
    {
      "id": "0090ea12-0bbc-4962-adb2-3761ba6688ad",
      "text": "订单状态变为CS_SERVICE_COMPLETED，给用户推送尾款账单",
      "position": "over",
      "lifelineIds": [
        "18d282d6-3057-496a-b70e-da4f5aa71868",
        "e1c6005d-764c-4126-9181-3b7b19dd5c85"
      ],
      "afterOrder": 7
    },
    {
      "id": "ff31bfae-8446-412f-8792-e8ee69cc7f36",
      "text": "{\n\torder_status:\"TO_PAY\",//待支付\n\tmileage_fee:90000,//增加了200元后的尾款\n\torder_fee:90000,//增加了200元后的尾款\n\tadditional_fee:0,\n\talipay_trade_no:\"2345\"//支付宝交易号\n}",
      "position": "over",
